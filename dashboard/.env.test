# .env.test - NON-SECRET placeholders. Committed on purpose, and must stay that
# way: `npm run build -- --mode test` is the whole gate (.no-mistakes.yaml) and
# reads this file. It needs zero real credentials.
#
# principal: Teable (read-only). 127.0.0.1:9 is the discard port, so a bundle
# built in this mode fails closed instead of reaching a real instance. That
# mattered most to the browser suite (removed 2026-08-20, which also deleted the
# mock backend these placeholders backstopped); keep the dead-port values anyway,
# for whatever runs this bundle next.
VITE_TEABLE_URL=http://127.0.0.1:9
VITE_TEABLE_TOKEN=test-teable-token-DO-NOT-USE-REAL
VITE_TEABLE_TABLE_ID=tbltest0000000000
# The Brands/Kingdom tab (the old gen.aditor.ai backend calls) was removed in 2026-07,
# so the Teable read above is now the app's only network boundary.
